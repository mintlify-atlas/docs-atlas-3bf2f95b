  "keyFeatures": [
    "Multi-scanner security analysis using Semgrep, Bandit, Checkov, pip-audit, npm-audit, Retire.js, and OSV",
    "Automated fix generation with pull request creation via GitHub integration",
    "Local workspace scanning with automatic zip upload from the CLI",
    "CI/CD integration with severity-threshold gating and non-zero exit codes",
    "Tiered subscription plans (Free, Team, Enterprise) with monthly quotas",
    "Background scan processing via Redis/RQ worker queue with Prometheus metrics",
    "JWT and API key authentication with Slack, Jira, and Git integrations",
    "Risk score calculation (0-10 scale) based on aggregated finding severities"
  ],
